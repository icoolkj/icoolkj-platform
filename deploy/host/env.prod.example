# 复制为 env.prod 并修改；勿提交真实密码到 Git
export SPRING_PROFILES_ACTIVE=prod

export DB_URL="jdbc:mysql://127.0.0.1:3306/icoolkj_platform?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true"
export DB_USERNAME=icoolkj
export DB_PASSWORD=ChangeMe_Db_Password

export REDIS_HOST=127.0.0.1
export REDIS_PORT=6379
export REDIS_PASSWORD=ChangeMe_Redis_Password

export JWT_SECRET=ChangeMe_Jwt_Secret_At_Least_32_Bytes_Long

# MinIO（若本机已装 MinIO）
export ICOOLKJ_STORAGE_PROVIDER=minio
export ICOOLKJ_STORAGE_ENDPOINT=http://127.0.0.1:9000
export ICOOLKJ_STORAGE_DOMAIN=http://127.0.0.1:9000
export ICOOLKJ_STORAGE_ACCESS_KEY=ChangeMe_Minio_Access_Key
export ICOOLKJ_STORAGE_SECRET_KEY=ChangeMe_Minio_Password
export ICOOLKJ_STORAGE_BUCKET=icoolkj

export DB_BACKUP_OUTPUT_DIR=/data/icoolkj-platform/data/db-backup
