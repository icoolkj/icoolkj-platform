# =============================================================================
# iCoolKJ Platform — Docker 生产环境（服务器只需本文件 + compose）
# 复制为 .env 并修改密码；镜像地址与 build-push 脚本保持一致
# =============================================================================

# 对外 HTTP 端口
HTTP_PORT=80

# 应用镜像（build-push 后填写；私有库示例见下）
# HTTP 私有库: registry.example.com:5000/icoolkj
# 阿里云 ACR:   registry.cn-hangzhou.aliyuncs.com/命名空间/icoolkj
IMAGE_REGISTRY=registry.example.com:5000/icoolkj
IMAGE_TAG=1.0.0

# MySQL
MYSQL_ROOT_PASSWORD=ChangeMe_Root_123!
MYSQL_DATABASE=icoolkj
MYSQL_USER=icoolkj
MYSQL_PASSWORD=ChangeMe_Db_123!

# Redis
REDIS_PASSWORD=ChangeMe_Redis_123!

# MinIO
MINIO_ROOT_USER=ChangeMe_Minio_User
MINIO_ROOT_PASSWORD=ChangeMe_Minio_123!
MINIO_BUCKET=icoolkj

# JWT（openssl rand -base64 32）
JWT_SECRET=ChangeMe_Jwt_Secret_At_Least_32_Bytes_Long

SPRING_PROFILES_ACTIVE=prod
