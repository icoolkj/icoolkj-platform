        "required": "请输入部门名称",
        "maxLength": "部门名称长度不能超过50"
      }
    },
    "deptCode": {
      "label": "部门编码",
      "placeholder": "请输入部门编码",
      "validation": {
        "maxLength": "部门编码长度不能超过64"
      }
    },
    "parentId": {
      "label": "上级部门",
      "placeholder": "请选择上级部门",
      "validation": {
        "required": "请选择上级部门",
        "maxLength": "父部门ID长度不能超过20"
      }
    },
    "sortNo": {
      "label": "排序",
      "placeholder": "请输入排序",
      "validation": {
        "required": "请输入显示顺序"
      }
    },
    "status": {
      "label": "状态",
