      },
      "parentId": {
        "required": true,
        "maxLength": 20
      },
      "leaderName": {
        "maxLength": 50
      },
      "phone": {
        "maxLength": 20
      },
      "email": {
        "maxLength": 100
      },
      "sortNo": {
        "required": true
      },
      "status": {
        "required": true,
        "maxLength": 1
      }
    }
