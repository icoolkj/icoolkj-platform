{
  "meta": {
    "businessName": "product",
    "apiModule": "system",
    "backendModule": "system",
    "permissionPrefix": "system:product",
    "className": "Product"
  },
  "page": {
    "layout": "standard-crud"
  },
  "query": {
    "maxVisible": 3,
    "collapsible": true,
    "fields": [
      {
        "field": "code",
        "component": "input",
        "queryType": "LIKE",
        "width": 160
      },
      {
        "field": "name",
        "component": "input",
        "queryType": "LIKE",
        "width": 160
      },
      {
        "field": "status",
        "component": "select",
        "queryType": "EQ",
        "dictType": "sys_common_status",
        "width": 140
      }
    ]
  },
  "table": {
    "fields": [
      {
        "field": "code",
        "component": "text",
        "minWidth": 120,
        "showOverflowTooltip": true
      },
      {
        "field": "name",
        "component": "text",
        "minWidth": 120,
        "showOverflowTooltip": true
      },
      {
        "field": "icon",
        "component": "icon",
        "width": 72,
        "align": "center"
      },
      {
        "field": "sortNo",
        "component": "text",
        "width": 80,
        "align": "center"
      },
      {
        "field": "status",
        "component": "dict-tag",
        "dictType": "sys_common_status",
        "width": 90,
        "align": "center"
      },
      {
        "field": "remark",
        "component": "text",
        "minWidth": 180,
        "showOverflowTooltip": true
      },
      {
        "field": "createdAt",
        "component": "text",
        "width": 170,
        "align": "center"
      }
    ],
    "actions": {
      "edit": true,
      "delete": true,
      "width": 160
    }
  },
  "form": {
    "mode": "dialog",
    "dialogWidth": 640,
    "labelWidth": 110,
    "closeOnClickModal": false,
    "closeOnPressEscape": false,
    "fields": [
      {
        "field": "code",
        "component": "input",
        "insert": true,
        "edit": false,
        "span": 24
      },
      {
        "field": "name",
        "component": "input",
        "insert": true,
        "edit": true,
        "span": 24
      },
      {
        "field": "nameEn",
        "component": "input",
        "insert": true,
        "edit": true,
        "span": 24
      },
      {
        "field": "icon",
        "component": "icon",
        "insert": true,
        "edit": true,
        "span": 24
      },
      {
        "field": "sortNo",
        "component": "input-number",
        "insert": true,
        "edit": true,
        "span": 24,
        "min": 0
      },
      {
        "field": "status",
        "component": "radio",
        "dictType": "sys_common_status",
        "insert": true,
        "edit": true,
        "span": 24
      },
      {
        "field": "remark",
        "component": "textarea",
        "insert": true,
        "edit": true,
        "span": 24,
        "rows": 3
      }
    ]
  }
}
