  "meta": {
    "businessName": "menu",
    "apiModule": "system",
    "functionName": "菜单",
    "constraints": {
      "menuName": {
        "required": true,
        "maxLength": 50
      },
      "menuNameEn": {
        "maxLength": 100
      },
      "menuType": {
        "required": true,
        "maxLength": 1
      },
      "routePath": {
        "maxLength": 200
      },
      "routeName": {
        "maxLength": 100
      },
      "componentPath": {
        "maxLength": 200
      },
      "permissionCode": {
        "maxLength": 100
      },
      "icon": {
        "maxLength": 100
      },
      "remark": {
        "maxLength": 500
      },
      "parentId": {
        "required": true,
        "maxLength": 20
      },
      "sortNo": {
        "required": true
      },
      "visible": {
        "required": true,
        "maxLength": 1
      },
      "status": {
        "required": true,
        "maxLength": 1
      },
      "assignScope": {
        "maxLength": 20
      },
      "productCode": {
        "required": true,
        "maxLength": 32
      },
      "isExternal": {
        "required": true
      },
      "isCache": {
        "required": true
      }
    }
  }
}
