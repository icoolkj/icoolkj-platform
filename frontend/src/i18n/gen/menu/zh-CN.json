{
  "page": {
    "title": "菜单",
    "description": "管理菜单，支持新增、修改与删除",
    "addTitle": "新增菜单",
    "editTitle": "修改菜单",
    "deleteConfirm": "确认删除选中的 {count} 条数据？",
    "statusNormal": "正常",
    "statusDisabled": "停用",
    "treeRoot": "顶级",
    "addChild": "新增子菜单",
    "showButtons": "显示按钮权限"
  },
  "fields": {
    "menuName": {
      "label": "菜单名称",
      "placeholder": "中文名（name_i18n.zh-CN / menu_name）",
      "validation": {
        "required": "请输入菜单名称",
        "maxLength": "菜单名称长度不能超过50"
      }
    },
    "menuNameEn": {
      "label": "英文名称",
      "placeholder": "可选（name_i18n.en-US）",
      "validation": {
        "maxLength": "英文名称长度不能超过100"
      }
    },
    "menuType": {
      "label": "菜单类型",
      "placeholder": "请选择菜单类型",
      "validation": {
        "required": "请选择菜单类型",
        "maxLength": "资源类型长度不能超过1"
      }
    },
    "parentId": {
      "label": "上级菜单",
      "placeholder": "请选择上级菜单",
      "validation": {
        "required": "请输入父资源ID",
        "maxLength": "父资源ID长度不能超过20"
      }
    },
    "routePath": {
      "label": "路由路径",
      "placeholder": "请输入路由路径",
      "validation": {
        "maxLength": "路由路径长度不能超过200"
      }
    },
    "routeName": {
      "label": "路由名称",
      "placeholder": "请输入路由名称",
      "validation": {
        "maxLength": "路由名称长度不能超过100"
      }
    },
    "componentPath": {
      "label": "组件路径",
      "placeholder": "请输入组件路径",
      "validation": {
        "maxLength": "组件路径长度不能超过200"
      }
    },
    "permissionCode": {
      "label": "权限标识",
      "placeholder": "请输入权限标识",
      "validation": {
        "maxLength": "权限标识长度不能超过100"
      }
    },
    "icon": {
      "label": "图标",
      "placeholder": "请选择图标",
      "validation": {
        "maxLength": "图标长度不能超过100"
      }
    },
    "sortNo": {
      "label": "排序",
      "placeholder": "请输入排序",
      "validation": {
        "required": "请输入显示顺序"
      }
    },
    "status": {
      "label": "状态",
      "placeholder": "请选择状态",
      "validation": {
        "required": "请输入状态 0正常 1停用",
        "maxLength": "状态 0正常 1停用长度不能超过1"
      }
    },
    "assignScope": {
      "label": "授权范围",
      "placeholder": "请选择授权范围",
      "validation": {
        "maxLength": "授权范围长度不能超过20"
      }
    },
    "productCode": {
      "label": "所属产品",
      "placeholder": "请选择所属产品",
      "validation": {
        "required": "请选择所属产品",
        "maxLength": "产品编码长度不能超过32"
      }
    },
    "remark": {
      "label": "备注",
      "placeholder": "请输入备注",
      "validation": {
        "maxLength": "备注长度不能超过500"
      }
    },
    "visible": {
      "label": "显示状态",
      "placeholder": "请选择显示状态",
      "validation": {
        "required": "请输入显示状态",
        "maxLength": "显示状态长度不能超过1"
      }
    },
    "isExternal": {
      "label": "是否外链",
      "placeholder": "请输入是否外链",
      "validation": {
        "required": "请输入是否外链"
      }
    },
    "isCache": {
      "label": "是否缓存",
      "placeholder": "请输入是否缓存",
      "validation": {
        "required": "请输入是否缓存"
      }
    }
