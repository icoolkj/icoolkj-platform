{
  "meta": {
    "businessName": "workflowTaskCc",
    "apiModule": "workflow",
    "backendModule": "workflow",
    "permissionPrefix": "workflow:cc",
    "className": "WorkflowTaskCc"
  },
  "readOnly": true,
  "page": { "layout": "standard-crud" },
  "query": {
    "maxVisible": 3,
    "collapsible": true,
    "fields": [
      { "field": "bizTitle", "component": "input", "queryType": "LIKE", "width": 200 },
      {
        "field": "bizType",
        "component": "select",
        "queryType": "EQ",
        "dictType": "wf_biz_type",
        "width": 140
      },
      { "field": "taskName", "component": "input", "queryType": "LIKE", "width": 160 }
    ]
  },
  "table": {
    "fields": [
      { "field": "bizTitle", "component": "text", "minWidth": 200, "showOverflowTooltip": true },
      { "field": "processDefinitionName", "component": "text", "minWidth": 140 },
      { "field": "taskName", "component": "text", "width": 140 },
      { "field": "starterUserName", "component": "text", "width": 120 },
      { "field": "createTime", "component": "datetime", "width": 170, "align": "center" },
      { "field": "endTime", "component": "datetime", "width": 170, "align": "center" }
    ],
    "actions": { "edit": false, "delete": false, "width": 120 }
  },
  "form": { "mode": "dialog", "fields": [] },
  "extensions": {
    "rowActions": [
      {
        "id": "ack",
        "labelKey": "ackAction",
        "permKey": "complete",
        "handler": "workflowTaskCc.ack",
        "allowOnReadOnly": true
      },
      {
        "id": "view",
        "labelKey": "viewAction",
        "handler": "workflowTaskCc.view",
        "allowOnReadOnly": true
      }
    ]
  }
}
