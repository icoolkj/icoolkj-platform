{
  "meta": {
    "businessName": "attachmentDemo",
    "apiModule": "infra",
    "backendModule": "infra",
    "permissionPrefix": "infra:attachmentDemo",
    "className": "AttachmentDemo"
  },
  "page": {
    "layout": "standard-crud"
  },
  "query": {
    "maxVisible": 3,
    "collapsible": true,
    "fields": [
      {
        "field": "title",
        "component": "input",
        "queryType": "LIKE",
        "width": 220
      },
      {
        "field": "status",
        "component": "select",
        "queryType": "EQ",
        "dictType": "sys_common_status",
        "width": 140
      }
    ]
  },
  "table": {
    "fields": [
      {
        "field": "title",
        "component": "text",
        "minWidth": 180,
        "showOverflowTooltip": true
      },
      {
        "field": "status",
        "component": "switch",
        "dictType": "sys_common_status",
        "width": 90,
        "align": "center",
        "activeValue": "0",
        "inactiveValue": "1"
      },
      {
        "field": "remark",
        "component": "text",
        "minWidth": 160,
        "showOverflowTooltip": true
      },
      {
        "field": "createdAt",
        "component": "datetime",
        "width": 170,
        "align": "center"
      }
    ],
    "actions": {
      "edit": false,
      "delete": false,
      "width": 200
    }
  },
  "form": {
    "mode": "dialog",
    "dialogWidth": 920,
    "labelWidth": 108,
    "fields": []
  },
  "fileCatalogs": [
    {
      "code": "attachment_demo",
      "tab": "form",
      "tabLabelKey": "sectionAttachments",
      "enableLabels": false
    }
  ],
  "extensions": {
    "rowActions": [
      {
        "id": "detail",
        "labelKey": "detailAction",
        "handler": "attachmentDemo.detail",
        "allowOnReadOnly": true
      },
      { "id": "edit", "builtin": "edit", "permKey": "update" },
      { "id": "delete", "builtin": "delete", "permKey": "delete", "type": "danger" }
    ]
  }
}
