  "meta": {
    "businessName": "dict",
    "apiModule": "system",
    "functionName": "字典管理",
    "constraints": {
      "dictName": { "required": true, "maxLength": 100 },
      "dictType": { "required": true, "maxLength": 100 },
      "status": { "required": true, "maxLength": 1 },
      "remark": { "maxLength": 500 },
      "dictLabel": { "required": true, "maxLength": 100 },
      "dictValue": { "required": true, "maxLength": 100 },
      "valueType": { "required": true, "maxLength": 20 },
      "icon": { "maxLength": 64 },
      "cssClass": { "maxLength": 100 },
      "listClass": { "maxLength": 100 },
      "isDefault": { "required": true, "maxLength": 1 },
      "sortNo": { "required": true }
    }
  }
