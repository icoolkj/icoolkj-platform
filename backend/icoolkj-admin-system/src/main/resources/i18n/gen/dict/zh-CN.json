  "fields": {
    "remark": {
      "label": "备注",
      "placeholder": "可选备注",
      "validation": {
        "maxLength": "备注长度不能超过 {max} 个字符"
      }
    },
    "status": {
      "label": "状态",
      "placeholder": "请选择状态",
