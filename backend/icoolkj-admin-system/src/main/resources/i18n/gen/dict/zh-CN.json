        "maxLength": "样式类长度不能超过 {max} 个字符"
      }
    },
    "dictLabel": {
      "label": "字典标签",
      "placeholder": "请输入字典标签",
      "validation": {
        "required": "请输入字典标签",
        "maxLength": "字典标签长度不能超过 {max} 个字符"
      }
    },
    "dictValue": {
      "label": "字典值",
      "placeholder": "请输入字典值",
      "validation": {
        "required": "请输入字典值",
        "maxLength": "字典值长度不能超过 {max} 个字符"
      }
    },
    "isDefault": {
      "label": "是否默认",
      "placeholder": "请选择是否默认",
      "validation": {
        "required": "请选择是否默认"
      }
    },
    "listClass": {
      "label": "回显样式",
      "placeholder": "请选择表格回显样式",
      "validation": {
        "maxLength": "回显样式长度不能超过 {max} 个字符"
      }
    },
    "valueType": {
      "label": "值类型",
      "placeholder": "请选择值类型",
      "validation": {
        "required": "请选择值类型",
        "maxLength": "值类型长度不能超过 {max} 个字符"
      }
    },
    "dictTypeId": {
      "label": "字典类型",
      "placeholder": "由左侧字典类型自动关联",
      "validation": {
        "required": "请先选择字典类型",
        "maxLength": "字典类型 ID 长度不能超过 {max} 个字符"
