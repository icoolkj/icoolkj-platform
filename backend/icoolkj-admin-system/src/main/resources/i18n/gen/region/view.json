        "dictType": "sys_region_level",
        "width": 100,
        "align": "center"
      },
      {
        "field": "sortNo",
        "component": "text",
        "width": 80,
        "align": "center"
      },
      {
        "field": "status",
        "component": "dict-tag",
        "dictType": "sys_common_status",
        "width": 90,
        "align": "center"
      }
    ],
    "actions": {
      "edit": true,
      "delete": true,
      "width": 220
    }
  },
  "form": {
    "mode": "dialog",
    "dialogWidth": 640,
    "labelWidth": 100,
    "closeOnClickModal": false,
    "closeOnPressEscape": false,
    "fields": [
      {
        "field": "parentId",
        "component": "tree-select",
        "insert": true,
        "edit": true,
        "span": 24,
        "treeSource": "self",
        "treeLabelField": "regionName",
        "treeValueField": "id"
      },
      {
        "field": "regionName",
        "component": "input",
        "insert": true,
        "edit": true,
        "span": 12
      },
      {
        "field": "regionCode",
        "component": "input",
        "insert": true,
        "edit": true,
        "span": 12
