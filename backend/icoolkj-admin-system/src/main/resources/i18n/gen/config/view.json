{
  "meta": {
    "businessName": "config",
    "apiModule": "system",
    "backendModule": "system",
    "permissionPrefix": "system:config",
    "className": "Config"
  },
  "page": {
    "layout": "standard-crud"
  },
  "query": {
    "maxVisible": 4,
    "collapsible": true,
    "fields": [
      {
        "field": "configName",
        "component": "input",
        "queryType": "LIKE",
        "width": 200
      },
      {
        "field": "configKey",
        "component": "input",
        "queryType": "LIKE",
        "width": 200
      },
      {
        "field": "configType",
        "component": "select",
        "queryType": "EQ",
        "dictType": "sys_config_type",
        "width": 140
      }
    ]
  },
  "table": {
    "fields": [
      {
        "field": "configName",
        "component": "text",
        "minWidth": 180,
        "showOverflowTooltip": true
      },
      {
        "field": "configKey",
        "component": "text",
        "minWidth": 220,
        "showOverflowTooltip": true
      },
      {
        "field": "configValue",
        "component": "text",
        "minWidth": 160,
        "showOverflowTooltip": true
      },
      {
        "field": "configType",
        "component": "dict-tag",
        "dictType": "sys_config_type",
        "width": 100,
        "minWidth": 120,
        "align": "center"
      },
      {
        "field": "remark",
        "component": "text",
        "minWidth": 160,
        "showOverflowTooltip": true
      },
      {
        "field": "createdAt",
        "component": "text",
        "width": 170,
        "align": "center"
      }
    ],
    "actions": {
      "edit": false,
      "delete": false,
      "width": 160
    }
  },
  "form": {
    "mode": "dialog",
    "dialogWidth": 860,
    "labelWidth": 120,
    "closeOnClickModal": false,
    "closeOnPressEscape": false,
    "fields": [
      {
        "field": "configName",
        "component": "input",
        "insert": true,
        "edit": true,
        "span": 24
      },
      {
        "field": "configKey",
        "component": "input",
        "insert": true,
        "edit": true,
        "span": 24,
        "disabledOnEdit": true
      },
      {
        "field": "configValue",
        "component": "textarea",
        "insert": true,
        "edit": true,
        "span": 24,
        "rows": 3
      },
      {
        "field": "configType",
        "component": "radio",
        "dictType": "sys_config_type",
        "insert": true,
        "edit": true,
        "span": 24
      },
      {
        "field": "remark",
        "component": "textarea",
        "insert": true,
        "edit": true,
        "span": 24,
        "rows": 2
      }
    ]
  },
  "extensions": {
    "rowActions": [
      { "id": "edit", "builtin": "edit", "permKey": "update" },
      {
        "id": "delete",
        "builtin": "delete",
        "permKey": "delete",
        "type": "danger",
        "disabledWhen": { "field": "configType", "values": ["Y"] }
      }
    ]
  }
}
