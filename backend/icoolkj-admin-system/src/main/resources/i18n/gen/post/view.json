{
  "meta": {
    "businessName": "post",
    "apiModule": "system",
    "backendModule": "system",
    "permissionPrefix": "system:post",
    "className": "Post"
  },
  "page": {
    "layout": "standard-crud"
  },
  "query": {
    "maxVisible": 4,
    "collapsible": true,
    "fields": [
      {
        "field": "postName",
        "component": "input",
        "queryType": "LIKE",
        "width": 200
      },
      {
        "field": "postCode",
        "component": "input",
        "queryType": "LIKE",
        "width": 200
      },
      {
        "field": "status",
        "component": "select",
        "queryType": "EQ",
        "dictType": "sys_common_status",
        "width": 140
      }
    ]
  },
  "table": {
    "fields": [
      {
        "field": "postName",
        "component": "text",
        "minWidth": 140,
        "showOverflowTooltip": true
      },
      {
        "field": "postCode",
        "component": "text",
        "minWidth": 140,
        "showOverflowTooltip": true
      },
      {
        "field": "sortNo",
        "component": "text",
        "width": 80,
        "minWidth": 120,
        "align": "center",
        "showOverflowTooltip": true
      },
      {
        "field": "status",
        "component": "dict-tag",
        "dictType": "sys_common_status",
        "width": 90,
        "minWidth": 120,
        "align": "center"
      },
      {
        "field": "remark",
        "component": "text",
        "minWidth": 140,
        "showOverflowTooltip": true
      },
      {
        "field": "createdAt",
        "component": "text",
        "width": 170,
        "align": "center"
      }
    ],
    "actions": {
      "edit": true,
      "delete": true,
      "width": 160
    }
  },
  "form": {
    "mode": "dialog",
    "dialogWidth": 860,
    "labelWidth": 100,
    "closeOnClickModal": false,
    "closeOnPressEscape": false,
    "fields": [
      {
        "field": "postName",
        "component": "input",
        "insert": true,
        "edit": true,
        "span": 24
      },
      {
        "field": "postCode",
        "component": "input",
        "insert": true,
        "edit": true,
        "span": 24
      },
      {
        "field": "sortNo",
        "component": "input-number",
        "insert": true,
        "edit": true,
        "span": 24,
        "min": 0
      },
      {
        "field": "status",
        "component": "radio",
        "dictType": "sys_common_status",
        "insert": true,
        "edit": true,
        "span": 24
      },
      {
        "field": "remark",
        "component": "textarea",
        "insert": true,
        "edit": true,
        "span": 24,
        "rows": 2
      }
    ]
  }
}
