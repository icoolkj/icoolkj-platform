<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.icoolkj.platform.system.sitemessage.mapper.SiteMessageMapper">

    <resultMap id="BaseResultMap" type="com.icoolkj.platform.system.sitemessage.domain.SiteMessageEntity">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="message_subject" property="messageSubject"/>
        <result column="message_category" property="messageCategory"/>
        <result column="message_content" property="messageContent"/>
        <result column="sender_id" property="senderId"/>
        <result column="user_id" property="userId"/>
        <result column="sender_name" property="senderName"/>
        <result column="sent_at" property="sentAt"/>
        <result column="created_by" property="createdBy"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_by" property="updatedBy"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, tenant_id, message_subject, message_category, message_content, sender_id, user_id, sender_name, sent_at,
        created_by, created_at, updated_by, updated_at, deleted
    </sql>

    <sql id="Query_Where">
        <where>
            deleted = 0
            <if test="tenantId != null and tenantId != ''">AND tenant_id = #{tenantId}</if>
            <if test="messageSubject != null and messageSubject != ''">
                AND message_subject LIKE CONCAT('%', #{messageSubject}, '%')
            </if>
            <if test="messageCategory != null and messageCategory != ''">
                AND message_category = #{messageCategory}
            </if>
            <if test="senderId != null and senderId != ''">AND sender_id = #{senderId}</if>
            <if test="dataScopeSql != null and dataScopeSql != ''">${dataScopeSql}</if>
        </where>
    </sql>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM sys_site_message
        WHERE id = #{id} AND deleted = 0
    </select>

    <select id="selectPage" resultMap="BaseResultMap">
        <bind name="offset" value="(pageNo - 1) * pageSize"/>
        SELECT <include refid="Base_Column_List"/>
        FROM sys_site_message
        <include refid="Query_Where"/>
        ORDER BY sent_at DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="countByQuery" resultType="long">
        SELECT COUNT(1) FROM sys_site_message
        <include refid="Query_Where"/>
    </select>

    <insert id="insert">
        INSERT INTO sys_site_message (
            id, tenant_id, message_subject, message_category, message_content,
            sender_id, user_id, sender_name, sent_at, created_by, created_at, updated_by, updated_at, deleted
        ) VALUES (
            #{id}, #{tenantId}, #{messageSubject}, #{messageCategory}, #{messageContent},
            #{senderId}, #{userId}, #{senderName}, #{sentAt}, #{createdBy}, #{createdAt}, #{updatedBy}, #{updatedAt}, #{deleted}
        )
    </insert>

    <delete id="deleteById">
        DELETE FROM sys_site_message WHERE id = #{id}
    </delete>

    <delete id="deleteByIds">
        DELETE FROM sys_site_message
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
