<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.icoolkj.platform.system.user.mapper.UserPasswordHistoryMapper">

    <resultMap id="BaseResultMap" type="com.icoolkj.platform.system.user.domain.UserPasswordHistoryEntity">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="user_id" property="userId"/>
        <result column="password_hash" property="passwordHash"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <insert id="insert">
        insert into sys_user_password_history (id, tenant_id, user_id, password_hash, created_at)
        values (#{id}, #{tenantId}, #{userId}, #{passwordHash}, #{createdAt})
    </insert>

    <select id="selectRecent" resultMap="BaseResultMap">
        select id, tenant_id, user_id, password_hash, created_at
        from sys_user_password_history
        where tenant_id = #{tenantId}
          and user_id = #{userId}
        order by created_at desc, id desc
        limit #{limit}
    </select>

    <delete id="deleteById">
        delete from sys_user_password_history where id = #{id}
    </delete>
</mapper>
