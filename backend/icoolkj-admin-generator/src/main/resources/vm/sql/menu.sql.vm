#if($grantTenantSuperRole)
-- 租户超级管理员角色（各租户 is_super_role=1）授权
insert into sys_role_menu (tenant_id, role_id, menu_id)
select r.tenant_id, r.id, m.id
from sys_role r
cross join (
  select '${menuPageId}' as id union all select '${menuBtnListId}' union all select '${menuBtnAddId}'
  union all select '${menuBtnUpdateId}' union all select '${menuBtnDeleteId}'#if($hasExport) union all select '${menuBtnExportId}'#end#if($hasImport) union all select '${menuBtnImportId}'#end
) m
where r.deleted = 0 and r.is_super_role = '1'
  and not exists (
    select 1 from sys_role_menu rm
    where rm.tenant_id = r.tenant_id and rm.role_id = r.id and rm.menu_id = m.id
  );
#end
